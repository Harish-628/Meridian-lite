# Large Datasets & Heavy Weights (exclude arbitrary weights, but whitelist essential offline demo & ONNX model)
models/weights/*.pt
models/weights/*.pth
!models/weights/damage_classifier.onnx

# Allow essential sample and benchmark disaster data for offline hackathon execution
!data/raw/hurricane_michael*
!data/processed/*
!data/demo/*

